# ─────────────────────────────────────────────────────────────────────────────
# Travyo — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ── PostgreSQL connection string ──────────────────────────────────────────────
# Local development example:
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/travyo

# Render (auto-injected from the linked database — no action needed):
# DATABASE_URL=postgresql://travyo_user:...@...render.com:5432/travyo

# ── Flask secret key (generate a long random string for production) ───────────
SECRET_KEY=change-me-to-a-long-random-string

# ── Admin credentials (override the defaults below for production) ────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@travyo.com
ADMIN_PASSWORD=change-me-in-production

# ── Optional: custom upload folder ───────────────────────────────────────────
# UPLOAD_FOLDER=/var/data/uploads
